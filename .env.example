DATABASE_URL=sqlite:///./scheduler.db
# Local development only. Set APP_AUTH_MODE=workos and the variables below for a deployment.
APP_AUTH_MODE=local
# WORKOS_API_KEY=
# WORKOS_CLIENT_ID=
# A Fernet key, generated with:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# WORKOS_COOKIE_PASSWORD=
# WORKOS_REDIRECT_URI=http://localhost:8000/v1/auth/callback
# WORKOS_POST_LOGIN_URL=/docs
# Optional provider credentials. Leave unset for local-only bookings.
# COMPOSIO_API_KEY=
# COMPOSIO_GOOGLE_AUTH_CONFIG_ID=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
